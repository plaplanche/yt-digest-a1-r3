{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TranscriptResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "video_id",
    "status",
    "lang",
    "source",
    "word_count",
    "truncated",
    "sponsor_ratio",
    "pages"
  ],
  "properties": {
    "video_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "status": {
      "$ref": "#/$defs/TranscriptStatus"
    },
    "lang": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/TranscriptSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "sponsor_ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "TranscriptStatus": {
      "type": "string",
      "enum": [
        "ok",
        "no_transcript",
        "unavailable",
        "blocked"
      ]
    },
    "TranscriptSource": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ]
    }
  }
}
